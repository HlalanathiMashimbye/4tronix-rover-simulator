rules_version = '2';

// Mission Control / Yard security rules.
//
// Trust model: every write that creates or advances a mission goes through the
// Admin SDK - mission-control's API routes and the yard operator console - and
// the Admin SDK bypasses these rules entirely. So the browser needs far less
// access than it used to have, and anything not matched below is denied.
//
// Learner email addresses are deliberately NOT on mission documents. Missions
// are world-readable (the discovery feed lists them, and the Firebase web
// config ships in the browser bundle), and rules cannot filter fields on read,
// so anything stored on a mission is public. Missions therefore carry only
// learnerEmailHash - a one-way hash the browser can match against to find its
// own history across devices - while the address itself lives on the learner
// record, which is gettable by exact id but never listable.

service cloud.firestore {
  match /databases/{database}/documents {

    // Roles come from the token's custom claim, not from a users/{uid}
    // document.
    //
    // There used to be two stores. These rules read users/{uid}.role while the
    // yard console read claims.role, so set-operator-role.mjs had to write both
    // and they still disagreed: it accepted operator OR admin, while this
    // accepted "operator" only, so an admin passed the console and was denied
    // here. That was a documented KNOWN GAP rather than an accident, and this
    // closes it.
    //
    // A claim also costs nothing to read. The get() below billed a document
    // read on every rule evaluation.
    //
    // The trade: claims refresh with the token, so a revoked role can linger up
    // to an hour here. set-operator-role.mjs calls revokeRefreshTokens on
    // revoke, and the operator console verifies its session cookie with
    // checkRevoked, so a removed operator loses the console immediately and
    // direct Firestore access shortly after.
    function role() {
      return request.auth != null ? request.auth.token.role : null;
    }

    // Admin is a superset of operator. Anything an operator may do, an admin
    // may do.
    function isOperator() {
      return role() == "operator" || role() == "admin";
    }

    function isAdmin() {
      return role() == "admin";
    }

    // There is deliberately no per-yard check here.
    //
    // A yardIds claim briefly existed, granted per account. The sponsor
    // rejected it on 2026-08-27: an operator logs in and CHOOSES a yard rather
    // than being assigned one, because which yard someone is standing next to
    // is a fact about this afternoon and not a property of their account.
    //
    // So an operator is an operator anywhere. The yard is a runtime selection
    // held client-side (infrastructure/config/yards.ts) and decides which queue
    // they are looking at, not what they are permitted to do.

    // Keys this write would add, change or remove.
    function touchedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Kept as a human-readable ledger of who holds which role, written by
    // set-operator-role.mjs. Nothing enforces access from it any more, so it is
    // documentation rather than a control.
    //
    // Read is narrowed from "any signed-in user" to admins: the list of
    // everyone with operator access is not something a signed-in learner needs.
    match /users/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Missions.
    //
    // Read is public: the discovery feed and mission detail pages are meant to
    // be shared, and learners are never signed in.
    //
    // Writes: creation and every status transition go through the Admin SDK, so
    // the browser gets exactly one narrow write - stamping learnerEmailHash onto
    // a mission submitted before the learner supplied an address (see
    // LearnerContext's backfillLatestMissionEmail). It may only fill a blank,
    // never overwrite, and may touch no other field.
    //
    // The 64-char length check pins it to a sha-256 hex digest, so this write
    // cannot be used to smuggle a plaintext address onto a public document.
    match /missions/{missionId} {
      allow get, list: if true;
      allow create, delete: if false;

      allow update: if touchedKeys().hasOnly(['learnerEmailHash'])
                    && !('learnerEmailHash' in resource.data)
                    && request.resource.data.learnerEmailHash is string
                    && request.resource.data.learnerEmailHash.size() == 64
                    && request.resource.data.learnerEmailHash.matches('^[0-9a-f]{64}$');
    }

    // Yards: the venues a rover lives in.
    //
    // World-readable for the same reason missions are: a learner's mission
    // page prints the city a run happened in, and it must resolve without an
    // account. There is nothing here that is not already on a public mission.
    //
    // Written only through the Admin SDK, which bypasses these rules, so the
    // admin settings page is the one way in. Note there is no delete, here or
    // in the repository: every mission ever run at a yard references its id,
    // so removing one orphans that history. Retiring sets active: false.
    match /yards/{yardId} {
      allow get, list: if true;
      allow write: if false;
    }

    // Runs: one per yard that attempted this mission, written only by the
    // Admin SDK (the satellite's outbox and the operator routes).
    //
    // Public read is deliberate and matches the mission itself. A learner has
    // to see which yards ran their program and which produced a video, and the
    // feed is public by design.
    match /missions/{missionId}/runs/{yardId} {
      allow get, list: if true;
      allow write: if false;
    }

    // Everything else under a mission is denied outright rather than left to
    // a catch-all read. The previous rule allowed read on ANY subcollection,
    // so a future audit trail recording which operator dispatched what would
    // have been world-readable the moment it was created, with nothing in
    // review to flag it.
    match /missions/{missionId}/{document=**} {
      allow read, write: if false;
    }

    // Learner records hold profile fields and an optional display name.
    //
    // They deliberately DO NOT hold the email address any more. `list` was
    // denied here so the collection could not be enumerated, but that was not
    // enough on its own: learner ids are published on world-readable mission
    // documents, so anyone could read the feed, collect ids from it, fetch
    // each learner document by exact id and read the address in plaintext.
    // That is bulk harvesting of children's email addresses from public data.
    //
    // Rules cannot hide a single field on read, so the address moved to the
    // `private` subcollection below, which browsers are denied entirely and
    // only the Admin SDK reaches (POST /api/learners/[id]/email writes it,
    // MissionNotificationService reads it).
    //
    // `learnerEmail` is therefore not an accepted key on create OR on update:
    // it is absent from both allowlists below, so a browser can neither set one
    // nor clear one. Clearing a legacy address is the API route's job, through
    // the Admin SDK, which bypasses these rules.
    //
    // (This comment previously said update accepted a null value. It never
    // did - the key is simply not in the update allowlist. The rules test
    // asserted the same wrong thing and had been failing unnoticed, because
    // nothing ran it.)
    //
    // NOTE: possession of a learner id still proves nothing, because those ids
    // are public. These rules stop the bulk READ; they cannot stop a forged
    // write. Closing that needs learner ids to stop being published at all.
    match /learners/{learnerId} {
      allow get: if true;
      allow list: if false;
      allow delete: if false;

      allow create: if request.resource.data.keys().hasOnly([
                      'id', 'sessionId', 'avatarColor', 'displayName',
                      'learnerRef', 'missionCount', 'completedMissions',
                      'createdAt', 'lastActiveAt', 'devices',
                      'learnerId', 'missionsCompleted', 'progress'
                    ]);

      allow update: if touchedKeys().hasOnly([
                      'displayName', 'avatarColor', 'learnerRef',
                      'lastActiveAt', 'missionCount', 'completedMissions',
                      'missionsCompleted', 'progress', 'devices'
                    ]);
    }

    match /learners/{learnerId}/{document=**} {
      allow read, write: if false;
    }

    // Leaderboard entries: pseudonymous public rankings
    // World-readable for public leaderboard display.
    // Written only through Admin SDK to prevent client manipulation.
    //
    // Only public entries (optedIn: true) should be visible, but rules cannot
    // filter on read, so the repository enforces this at query time.
    //
    // Challenge completion is recorded via Admin SDK routes, never directly by client.
    match /leaderboardEntries/{learnerHash} {
      allow get, list: if true;
      allow write: if false;
    }
  }
}

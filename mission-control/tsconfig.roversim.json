{
  // Builds the shared rover simulator (physics + trajectory + canvas renderer)
  // into plain ES modules the yard satellite can load directly from a <script
  // type="module">, so the monitor page animates a fake rover using THE SAME
  // code mission-control renders with, rather than a second implementation of
  // it that has to be kept in step by hand.
  //
  // roverBlockly.ts is here too, and it is the reason the yard editor and the
  // hub editor cannot drift: both load THIS file's blocks, toolbox and Python
  // generator. It used to be duplicated by hand into code.html, with a comment
  // in each copy asking humans to mirror changes into the other.
  //
  // Deliberately tsc and not a bundler: these files import almost nothing
  // at runtime (rover-physics and roverSimRender have zero imports; the other
  // two have one local import and one type-only import that is erased), so a
  // bundler would buy nothing and add a dependency to a satellite that is
  // otherwise plain static files. Native ES modules are enough.
  //
  // Run via `npm run build:roversim` - see scripts/build-roversim.mjs, which
  // also fixes up the extensionless relative import tsc emits.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"]
    },
    "outDir": "../yard/satellite/static/roversim",
    "rootDir": "src/lib"
  },
  "files": [
    "src/lib/rover-physics.ts",
    "src/lib/simulateCommands.ts",
    "src/lib/parseRoverCode.ts",
    "src/lib/roverSimRender.ts",
    "src/lib/roverBlockly.ts"
  ]
}

# Firebase auth is ADC only: gcloud auth application-default login
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

FIREBASE_PROJECT_ID=your-project-id

# "prod" | "staging" | unset. Terraform sets it per service.
# APP_ENV=staging

# APP_URL is runtime and wins. NEXT_PUBLIC_APP_URL is frozen at build time.
# APP_URL=https://marsyard.sapient.rocks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Blank uses the yard registry. Must match YARD_ID on the satellite.
# NEXT_PUBLIC_YARD_ID=curiosity

# Local dev only. In a deployment these live in Secret Manager and are edited
# at /operator/settings by an admin; an env var here overrides that, which is
# what keeps local dev working without Google credentials.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=missions@sapient.rocks
# While set, ALL mail goes here and no learner gets any.
# RESEND_SANDBOX_RECIPIENT=owner_of_the_resend_account@example.com

# --- YouTube auto-link (POST /api/cron/youtube-link, on a schedule) ---
# Matches "MissionID: <id>" in an upload's description. Moved here from the
# yard: an operator uploads after leaving the venue, when the Pi is off.
# Same as Resend: local overrides for what /operator/settings owns in a
# deployment. YOUTUBE_LINK_INTERVAL_MINUTES has a floor of 5.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_LINK_INTERVAL_MINUTES=
# Shared secret Cloud Scheduler sends as x-cron-secret. Generated by Terraform
# in a deployment. Unset = nobody can trigger it, including Scheduler.
CRON_SECRET=

NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com



# Rover Pi server. Empty file runs.
# ROVER_URL and MISSION_CONTROL_URL belong to the satellite, not here.

# Blank uses yard/rover/vendor. rover-server.service sets it explicitly.
ROVER_LIB_PATH=
# Blank: /tmp/rover_photo.jpg
ROVER_PHOTO_PATH=
# "1" enables Flask debug. Leave unset on a yard Pi.
FLASK_DEBUG=

POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# Old .env: delete ROVER_SERVER_PORT, YARD_TYPE, YARD_NAME. Nothing reads them.

# Rover Pi server configuration.
# Copy to .env and adjust per rover. Every value has a working default in code,
# so an empty .env runs.
#
# This file is for the process on the ROVER Pi (yard/rover/rover_server.py).
# ROVER_URL and MISSION_CONTROL_URL are not read here: they belong to the
# satellite, which is the thing that talks to both. See
# yard/satellite/.env.example.

# --- The 4tronix rover library ---
#
# Directory holding rover.py. Defaults to the copy vendored at
# yard/rover/vendor, so nothing bakes in a machine layout: the hardcoded
# /home/mars/marsrover that used to live in the code was called out in the
# iteration 2 marksheet and is gone.
#
# yard/deploy/rover-server.service sets this explicitly, so the deployment
# describes itself rather than relying on the default. Only set it here if the
# library lives somewhere else on your Pi.
#
# Note this is only half of what the Pi needs on its path: rover.py imports
# pca9685, which is not vendored and still comes from the 4tronix install.
# See yard/rover/vendor/README.md.
# ROVER_LIB_PATH=/home/mars/4tronix-rover-simulator/yard/rover/vendor

# --- Photos ---
#
# Where take_photo() writes the frame that GET /photo then serves.
# Blank uses /tmp/rover_photo.jpg.
# ROVER_PHOTO_PATH=

# --- Debug ---
#
# "1" or "true" turns on Flask debug and sends rover telemetry to PostHog in
# debug mode. Leave unset on a real yard Pi.
# FLASK_DEBUG=

# --- PostHog server analytics ---
# Copy the values from the project configuration. Unset disables telemetry.
POSTHOG_PROJECT_TOKEN=<ph_project_token>
POSTHOG_HOST=https://eu.i.posthog.com

# --- If your .env predates this file ---
#
# ROVER_SERVER_PORT, YARD_TYPE and YARD_NAME were documented here but are read
# by nothing in the repo. The port is hardcoded in rover_server.py (8523) and
# the systemd unit does not set it either; the yard's identity lives in the registry
# at mission-control/src/infrastructure/config/yards and in the satellite's
# satellite_config.json. Delete all three: a variable that looks live but
# changes nothing is worse than no variable at all.

# Copy to .env and fill in.
#
# LEAVE THE FIREBASE VALUES BLANK unless you have a reason not to. The dev
# launcher layers mission-control/.env UNDER this file, so anything set here
# overrides the shared Firebase config - and a stale copy here is how the
# satellite ended up talking to a retired project for a month while Mission
# Control talked to the live one (fixed 2026-08-29). Blank means inherit.

# --- Rover / web server ---
ROVER_URL=http://marspi.local:8523
SATELLITE_PORT=3001
CAMERA_PORT=8890

# --- Operator console (/operator/) ---
#
# All four are optional and normally stay EMPTY, inherited from
# mission-control/.env. Credentials then come from Application Default
# Credentials, matching how staging and prod authenticate - no key to rotate
# or leak:
#
#     gcloud auth application-default login
#
# Set CLIENT_EMAIL and PRIVATE_KEY only to use a specific service account, and
# then set BOTH: exactly one is treated as a broken .env and refused, because
# falling back to ADC would silently authenticate as a different identity.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative to the two credential vars above: path to a service-account JSON key.
# GOOGLE_APPLICATION_CREDENTIALS=

# Falls back to NEXT_PUBLIC_FIREBASE_API_KEY from mission-control/.env.
FIREBASE_WEB_API_KEY=
# Optional. Unset means operator sessions reset whenever the satellite restarts.
OPERATOR_SESSION_SECRET=
# Event-day escape hatch: set to "off" to skip operator login entirely when
# venue wifi can't reach Firebase. See operator_console.py for details.
# OPERATOR_AUTH=off

# --- YouTube auto-link poll (optional; unset disables it, manual attach still works) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# OAuth client for a future automated-upload flow. Not consumed by any code
# yet - the auto-link poll above only needs the API key + channel ID.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

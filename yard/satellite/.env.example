# Copy to .env. An empty file runs.
#
# The satellite has no Firebase or YouTube OAuth credentials. When automatic
# uploads are configured, it uses a separate shared credential to deliver
# completed recordings to Mission Control.

# --- Bootstrap (must be env: read before anything else) ---
SATELLITE_PORT=3001
CAMERA_PORT=8890
# Where the satellite keeps its own config. Defaults to a file beside the code.
SATELLITE_CONFIG=

# --- Identity ---
# Which yard this is. Must match the yard in Mission Control, because it is
# half of what identifies a run: recordings are named
# <mission>__<yard>__<UTC stamp>.mp4 and that is what the platform matches an
# upload against.
#
# Env beats the config file, so a value here freezes it. Leave blank on a box
# you might rename.
YARD_ID=

# Both of these are set on the Settings page now (the link button beside
# power), which wins over anything here. Set them here only to seed a fresh
# satellite. The upload secret is a satellite-to-server credential, not a
# YouTube or Firebase token, and is sent only to the Mission Control it was
# given for: one set here belongs to MISSION_CONTROL_URL, or to prod if that is
# blank.
MISSION_CONTROL_URL=
YOUTUBE_UPLOAD_INGEST_SECRET=

# --- Settings page owns these, leave blank ---
# Editable at /settings without a restart; these are only the defaults.
ROVER_URL=
CAMERA_INDEX=
CAMERA_HOST=
CAMERA_READY_TIMEOUT=

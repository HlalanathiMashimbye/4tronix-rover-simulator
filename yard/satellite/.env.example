# Copy to .env and fill in.
#
# LEAVE THE FIREBASE VALUES BLANK unless you have a reason not to. The dev
# launcher layers mission-control/.env UNDER this file, so anything set here
# overrides the shared Firebase config - and a stale copy here is how the
# satellite ended up talking to a retired project for a month while Mission
# Control talked to the live one (fixed 2026-08-29). Blank means inherit.

# --- Which yard this satellite is ---
#
# Must match NEXT_PUBLIC_YARD_ID on the Mission Control side. The satellite
# pulls only missions addressed to its own yard, so a mismatch shows up as a
# permanently empty queue with nothing logged to explain it. The real yard was
# renamed from uct-rover-1 to the rover's mDNS name on 2026-08-27; anything
# still saying uct-rover-1 is stale.
YARD_ID=curiosity

# Path to this satellite's identity file, which carries the yard's registered
# id and name. Blank uses <satellite dir>/satellite_config.json. Point it
# elsewhere to run two satellites from one checkout without them fighting over
# the same identity.
SATELLITE_CONFIG=

# --- Rover / web server ---
ROVER_URL=http://marspi.local:8523
SATELLITE_PORT=3001
CAMERA_PORT=8890
# Host the camera stream is served from. Blank uses localhost, which is right
# when the camera process runs on the satellite itself.
CAMERA_HOST=
# Which camera device to open when the Pi has more than one. Blank uses 0. If
# the stream comes up black, this is the first thing to try.
CAMERA_INDEX=
# Where the satellite reaches Mission Control to notify it of status changes.
# Blank uses http://localhost:3000.
MISSION_CONTROL_URL=

# --- Mission recording (BACKLOG 334/335/336/338) ---
# Where recorded mission videos are written, one <missionId>__<yardId>.mp4
# per run. Blank uses <satellite dir>/recordings.
RECORDING_DIR=
# How long "Send to rover" waits for a real frame from the camera before
# refusing to dispatch. The camera process being up is not enough - this
# proves frames are actually flowing.
CAMERA_READY_TIMEOUT=2.0

# --- Offline mirror ---
#
# The local SQLite mirror of Firestore. Blank uses <satellite dir>/missions.db.
# Point it at a throwaway path, or :memory:, to run against a scratch mirror.
# The mirror is a cache: it repairs its own schema on boot and can be deleted
# and rebuilt, but check the outbox is empty first, because unflushed local
# writes live there and nowhere else.
MISSION_MIRROR_DB=

# --- Sync worker ---
#
# Seconds between sync cycles, and how many cycles between full reconciles.
# These are the Firestore bill: at SYNC_INTERVAL=30 with a reconcile every 10
# cycles the satellite reads roughly 10,000 documents a day. Raising the
# interval is the cheapest lever if the quota gets tight. Blank uses 30 and 10.
SYNC_INTERVAL=
SYNC_RECONCILE_EVERY=

# --- Operator console (/operator/) ---
#
# All four are optional and normally stay EMPTY, inherited from
# mission-control/.env. Credentials then come from Application Default
# Credentials, matching how staging and prod authenticate - no key to rotate
# or leak:
#
#     gcloud auth application-default login
#
# Set CLIENT_EMAIL and PRIVATE_KEY only to use a specific service account, and
# then set BOTH: exactly one is treated as a broken .env and refused, because
# falling back to ADC would silently authenticate as a different identity.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative to the two credential vars above: path to a service-account JSON
# key. Same objection as the pair above, for the same reason - a downloaded key
# is a long-lived credential that nothing expires. Prefer ADC.
# GOOGLE_APPLICATION_CREDENTIALS=

# Falls back to NEXT_PUBLIC_FIREBASE_API_KEY from mission-control/.env.
FIREBASE_WEB_API_KEY=

# Signs operator session cookies. Unset means sessions reset whenever the
# satellite restarts, which is fine locally and wrong on a yard Pi. Generate a
# real one rather than typing something memorable:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Treat it as a credential: a known value lets anyone mint an operator session.
OPERATOR_SESSION_SECRET=
# How long an operator session lasts, and how often it is rechecked against
# Firebase, both in seconds. Blank uses 43200 (12 hours) and 300 (5 minutes).
OPERATOR_SESSION_MAX_AGE=
OPERATOR_SESSION_RECHECK=
# Event-day escape hatch: set to "off" to skip operator login entirely when
# venue wifi can't reach Firebase. See console/auth.py for details.
# OPERATOR_AUTH=off

# --- YouTube auto-link poll (optional; unset disables it, manual attach still works) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# OAuth client for a future automated-upload flow. Not consumed by any code
# yet - the auto-link poll above only needs the API key + channel ID. The
# secret is a real credential even though nothing reads it yet, so it belongs
# in .env and never in a commit, a doc, or a chat message.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Copy to .env. Empty file runs. mission-control/.env layers under this.
# Firebase auth is ADC only: gcloud auth application-default login

# --- Bootstrap (must be env) ---
SATELLITE_PORT=3001
CAMERA_PORT=8890
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
SATELLITE_CONFIG=
MISSION_MIRROR_DB=

# --- Secrets ---
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# YouTube keys moved to mission-control: linking uploads happens there now.
OPERATOR_SESSION_SECRET=

# Skips operator login when the venue cannot reach Firebase.
# OPERATOR_AUTH=off

# --- Settings page owns these, leave blank ---
# YARD_ID excepted: env beats config, so a value here freezes the yard.
YARD_ID=
ROVER_URL=
CAMERA_INDEX=
SYNC_INTERVAL=
SYNC_RECONCILE_EVERY=

# --- Deployment wiring ---
# REQUIRED on a real yard. Unset means status emails are never sent: the
# satellite POSTs the change to localhost and the failure is swallowed.
MISSION_CONTROL_URL=

# Copy to .env. Every value is optional and has a default in code, so an empty
# file runs. Two things are worth knowing before you fill anything in:
#
# 1. The dev launcher layers mission-control/.env UNDER this file, so anything
#    set here WINS. Blank means inherit. A stale Firebase value here is how the
#    satellite talked to a retired project for a month while Mission Control
#    talked to the live one (fixed 2026-08-29).
#
# 2. Firebase credentials come from Application Default Credentials only:
#
#        gcloud auth application-default login
#
#    There is no service-account option. FIREBASE_CLIENT_EMAIL and
#    FIREBASE_PRIVATE_KEY are refused at startup if set, rather than ignored.

# --- Identity ---
# Must match NEXT_PUBLIC_YARD_ID in mission-control, or this satellite pulls an
# empty queue and logs nothing to explain why. Renamed from uct-rover-1 on
# 2026-08-27; anything still saying that is stale.
YARD_ID=curiosity
FIREBASE_PROJECT_ID=
# Blank uses <satellite dir>/satellite_config.json.
SATELLITE_CONFIG=

# --- Ports and hosts ---
ROVER_URL=http://marspi.local:8523
SATELLITE_PORT=3001
CAMERA_PORT=8890
# Blank: localhost.
CAMERA_HOST=
# Blank: 0. First thing to try if the camera stream comes up black.
CAMERA_INDEX=
# Blank: http://localhost:3000.
MISSION_CONTROL_URL=

# --- Recording (BACKLOG 334/335/336/338) ---
# Blank: <satellite dir>/recordings.
RECORDING_DIR=
# Seconds "Send to rover" waits for a real frame before refusing to dispatch.
# The camera process being up is not enough; this proves frames are flowing.
CAMERA_READY_TIMEOUT=2.0

# --- Offline mirror and sync ---
# Local SQLite mirror of Firestore. Blank uses <satellite dir>/missions.db.
# It is a cache and repairs its own schema on boot, but check the outbox is
# empty before deleting it: unflushed local writes live there and nowhere else.
MISSION_MIRROR_DB=
# Seconds between sync cycles, and cycles between full reconciles. These are
# the Firestore bill: 30 and 10 is roughly 10,000 reads a day. Raising the
# interval is the cheapest lever if quota gets tight. Blank uses 30 and 10.
SYNC_INTERVAL=
SYNC_RECONCILE_EVERY=

# --- Operator console (/operator/) ---
# Blank falls back to NEXT_PUBLIC_FIREBASE_API_KEY from mission-control/.env.
FIREBASE_WEB_API_KEY=
# Signs operator session cookies. Blank means sessions reset on every restart,
# which is fine locally and wrong on a yard Pi. Generate one, do not invent one:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATOR_SESSION_SECRET=
# Blank: 43200 (12 hours) and 300 (5 minutes).
OPERATOR_SESSION_MAX_AGE=
OPERATOR_SESSION_RECHECK=
# Event-day escape hatch: "off" skips operator login entirely when venue wifi
# cannot reach Firebase. See console/auth.py.
# OPERATOR_AUTH=off

# --- YouTube auto-link poll (blank disables it; manual attach still works) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# For a future automated-upload flow; no code reads these yet. The secret is
# still a real credential, so it belongs here and never in a commit or a chat.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
